{
  "schema": "bcir-build-manifest.v1",
  "comment": [
    "The one list of what the C and C++ rails are made of. CMake reads it (cmake/BCIRManifest.cmake)",
    "and bcir/tests/test_build_manifest.py holds every shell gate and Python harness to it:",
    "a unit linked anywhere must be linked from here, with the same sources (docs/BCIR_BUILD_ROADMAP.md).",
    "Sources are basenames under runtime/c (seam_* kinds: under runtime/cpp). `libraries` names other",
    "units of this file; `link` names system libraries (m, pthread); `class` is the unit's memory",
    "class from runtime/c/MEMORY_CLASSIFICATION.txt, one per library; `options` are GNU-style compile",
    "options the gates pass for that unit (`gcc:`/`clang:` prefixes scope one to that compiler);",
    "`max_len` is libFuzzer's -max_len, absent when unbounded. `sections` are the gate sections that",
    "moved into tools/c/sections/*.sh (BUILD-2): the script and the binaries it takes, in order --",
    "manifest harnesses, `tools` (bcir-cc, for the sections that drive it; a script that compiles what",
    "it emits takes the compiler as CC) or `variants`. A variant is a harness rebuilt with its whole library closure:",
    "with extra `options` (the optimisation sweeps) or with one `mutation` of one source (the",
    "fault-injection witnesses, applied by tools/build/mutate.py for the gate and the CMake build alike),",
    "in another C `standard` than the harness's C23 (the two-standard sections), or with a `sanitizer`,",
    "built only where tools/build/sanitizer.py finds its runtime working (BCIR_REQUIRE_TSAN makes absence",
    "fail). A section's `varies` patterns name values its output prints that are not a function of its",
    "binaries: each is a regex whose one capture group is the varying value, masked before",
    "tools/build/section_parity.py compares the two builds' outputs byte for byte (the ring's count of",
    "concurrent runs that caught the injected race varies from run to run; every other byte of every",
    "section must not)."
  ],
  "libraries": {
    "bcir_base": {
      "class": "freestanding_core",
      "sources": ["bcir_runtime.c", "bcir_sha256.c"]
    },
    "bcir_streampack": {
      "class": "freestanding_core",
      "sources": [
        "bcir_plan.c", "bcir_hydrate.c", "bcir_exec.c", "bcir_encode.c", "bcir_decode.c",
        "bcir_binrec.c", "bcir_train.c", "bcir_telemetry_frame.c", "bcir_provenance.c"
      ],
      "libraries": ["bcir_base"],
      "link": ["m"]
    },
    "bcir_plane": {
      "class": "freestanding_core",
      "sources": [
        "bcir_control_plane.c", "bcir_ring.c", "bcir_telemetry_envelope.c", "bcir_handoff.c",
        "bcir_shard_manifest.c", "bcir_kplan.c"
      ],
      "libraries": ["bcir_streampack", "bcir_base"]
    },
    "bcir_artifact": {
      "class": "freestanding_core",
      "sources": ["bcir_artifact_bundle.c"],
      "libraries": ["bcir_base"]
    },
    "bcir_asn1": {
      "class": "freestanding_core",
      "sources": [
        "bcir_asn1.c", "bcir_asn1_streampack.c", "bcir_per.c", "bcir_per_plan.c", "bcir_oer.c",
        "bcir_xer.c", "bcir_jer.c", "bcir_emit.c"
      ],
      "libraries": ["bcir_base"]
    },
    "bcir_cfront": {
      "class": "hosted_tool",
      "sources": ["bcir_cfront.c", "bcir_cpp.c", "bcir_verify.c", "bcir_diag.c"],
      "libraries": ["bcir_base"],
      "options": ["-Wno-misleading-indentation", "gcc:-Wno-stringop-truncation", "gcc:-Wno-format-truncation", "gcc:-Wno-maybe-uninitialized"]
    },
    "bcir_quarantine": {
      "class": "hosted_tool",
      "sources": ["bcir_quarantine.c", "bcir_quarantine_recover.c"],
      "link": ["pthread"]
    },
    "bcir_models": {
      "class": "hosted_tool",
      "sources": ["bcir_q8_model.c", "bcir_q4_kernel.c", "bcir_ai_kernels.c", "bcir_llama.c"],
      "libraries": ["bcir_streampack", "bcir_base"],
      "link": ["m"],
      "options": ["-ffp-contract=off"]
    },
    "bcir_channel": {
      "class": "hosted_tool",
      "sources": ["bcir_channel.c"]
    },
    "bcir_driver": {
      "class": "driver_adapter",
      "sources": ["bcir_runtime_channel.c"]
    }
  },
  "tools": {
    "bcir-cc": {
      "sources": ["bcir_cc.c"],
      "libraries": ["bcir_cfront", "bcir_streampack", "bcir_base"]
    },
    "bcir_asn1_bench": {
      "sources": ["bcir_asn1_bench.c"],
      "libraries": ["bcir_asn1", "bcir_base"]
    },
    "bcir_microbench": {
      "sources": ["bcir_microbench.c"]
    },
    "bcir_ai_microbench": {
      "sources": ["bcir_ai_microbench.c"],
      "libraries": ["bcir_models"],
      "options": ["-ffp-contract=off"]
    },
    "bcir-llama": {
      "sources": ["bcir_llama_cli.c"],
      "libraries": ["bcir_models", "bcir_streampack", "bcir_base"],
      "options": ["-ffp-contract=off"]
    }
  },
  "harnesses": {
    "test_runtime": {"sources": ["test_runtime.c"], "libraries": ["bcir_base"]},
    "test_sha256": {"sources": ["test_sha256.c"], "libraries": ["bcir_base"]},
    "test_execution_plan": {"sources": ["test_execution_plan.c"], "libraries": ["bcir_base"]},
    "test_exec": {"sources": ["test_exec.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "test_encode": {"sources": ["test_encode.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "test_decode": {"sources": ["test_decode.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "test_binrec": {"sources": ["test_binrec.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "test_train": {"sources": ["test_train.c"], "libraries": ["bcir_streampack", "bcir_base"], "link": ["m"]},
    "test_train_stream": {"sources": ["test_train_stream.c"], "libraries": ["bcir_streampack", "bcir_base"], "link": ["m"]},
    "test_telemetry_frame": {"sources": ["test_telemetry_frame.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "test_artifact_bundle": {"sources": ["test_artifact_bundle.c"], "libraries": ["bcir_artifact", "bcir_base"]},
