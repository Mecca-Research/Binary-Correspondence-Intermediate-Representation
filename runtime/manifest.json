      "link": ["pthread"]
    },
    "bcir_jer_index": {
      "sources": ["bcir_jer_index.cpp", "bcir_jer_simd.cpp"],
      "libraries": ["bcir_asn1", "bcir_base"]
    }
  },
  "seam_tests": {
    "test_orchestrator": {"sources": ["test_orchestrator.cpp"], "libraries": ["bcir_seam"]},
    "test_handoff_cpp": {"sources": ["test_handoff.cpp"], "libraries": ["bcir_seam"]},
    "test_artifact_bundle_cpp": {"sources": ["test_artifact_bundle.cpp"], "libraries": ["bcir_artifact", "bcir_base"]},
    "test_jer_index": {"sources": ["test_jer_index.cpp"], "libraries": ["bcir_jer_index"]},
    "test_jer_simd": {"sources": ["test_jer_simd.cpp"], "libraries": ["bcir_jer_index"]}
  },
  "variants": {
    "test_control_plane_mutant": {
      "of": "test_control_plane",
      "mutation": {"file": "bcir_control_plane.c", "find": "s->in_flight != 0u || s->boundary < r.hdr.boundary", "replace": "s->boundary < r.hdr.boundary"}
    },
    "test_ring_O0": {"of": "test_ring", "options": ["-O0"]},
    "test_ring_O3": {"of": "test_ring", "options": ["-O3"]},
    "test_ring_torn": {
      "of": "test_ring",
      "mutation": {"file": "bcir_ring.c", "find": "  if (seq != c->cur_seq) return overwrite ? lose(c, q, 1) : refused(BCIR_ERR_RING, q);", "replace": "  (void)seq;"}
    },
    "test_handoff_O0": {"of": "test_handoff", "options": ["-O0"]},
    "test_handoff_O3": {"of": "test_handoff", "options": ["-O3"]},
    "test_handoff_mutant": {
      "of": "test_handoff",
      "mutation": {"file": "bcir_handoff.c", "find": "if (s->admitted_generation != gen ||", "replace": "if (0 && (s->admitted_generation != gen) ||"}
    },
    "test_kplan_O0": {"of": "test_kplan", "options": ["-O0"]},
    "test_kplan_O3": {"of": "test_kplan", "options": ["-O3"]},
    "test_kplan_mutant": {
      "of": "test_kplan",
      "mutation": {"file": "bcir_kplan.c", "find": "r.hi = a.hi + b.hi + (r.lo < a.lo ? 1u : 0u);", "replace": "r.hi = a.hi + b.hi;"}
    },
    "test_x86_interrupt_c11": {"of": "test_x86_interrupt", "standard": 11},
    "test_q8_tables_c11": {"of": "test_q8_tables", "standard": 11},
    "test_ring_tsan": {"of": "test_ring", "standard": 11, "sanitizer": "thread", "options": ["-O1", "-g"]},
    "test_ring_plain": {
      "of": "test_ring",
      "standard": 11,
      "sanitizer": "thread",
      "options": ["-O1", "-g"],
      "mutation": {"file": "bcir_ring.c", "find": "  atomic_store_explicit(word_at(r, off), (unsigned long long)v, memory_order_relaxed);", "replace": "  *(unsigned long long *)(void *)(r + off) = (unsigned long long)v;"}
    }
  },
  "sections": {
    "x86_interrupt": {"script": "tools/c/sections/x86_interrupt.sh", "harnesses": ["test_x86_interrupt_c11", "test_x86_interrupt"]},
    "runtime": {"script": "tools/c/sections/runtime.sh", "harnesses": ["test_runtime"]},
    "artifact_bundle": {"script": "tools/c/sections/artifact_bundle.sh", "harnesses": ["test_sha256", "test_artifact_bundle", "test_asn1"]},
    "executor": {"script": "tools/c/sections/executor.sh", "harnesses": ["test_exec"]},
    "encoder": {"script": "tools/c/sections/encoder.sh", "harnesses": ["test_encode"]},
    "execution_plan": {"script": "tools/c/sections/execution_plan.sh", "harnesses": ["test_execution_plan"]},
    "telemetry_frame": {"script": "tools/c/sections/telemetry_frame.sh", "harnesses": ["test_telemetry_frame"]},
    "q8_tables": {"script": "tools/c/sections/q8_tables.sh", "harnesses": ["test_q8_tables_c11", "test_q8_tables"]},
    "control_plane": {"script": "tools/c/sections/control_plane.sh", "harnesses": ["test_control_plane", "test_control_plane_mutant"]},
    "ring": {
      "script": "tools/c/sections/ring.sh",
      "harnesses": ["test_ring", "test_ring_O0", "test_ring_O3", "test_ring_torn"],
      "varies": ["injected fault .*concurrent\\.violations=([0-9]+)"]
    },
    "ring_tsan": {"script": "tools/c/sections/ring_tsan.sh", "harnesses": ["test_ring_tsan", "test_ring_plain"]},
    "handoff": {"script": "tools/c/sections/handoff.sh", "harnesses": ["test_handoff", "test_handoff_O0", "test_handoff_O3", "test_handoff_mutant"]},
    "kplan": {"script": "tools/c/sections/kplan.sh", "harnesses": ["test_kplan", "test_kplan_O0", "test_kplan_O3", "test_kplan_mutant"]},
    "cfront": {"script": "tools/c/sections/cfront.sh", "harnesses": ["test_cfront"]},
    "cfront_abi": {"script": "tools/c/sections/cfront_abi.sh", "harnesses": ["test_cfront"]},
    "cfront_loop": {"script": "tools/c/sections/cfront_loop.sh", "harnesses": ["test_cfront_loop"]},
    "channel": {"script": "tools/c/sections/channel.sh", "harnesses": ["test_channel"]},
    "bcir_cc": {"script": "tools/c/sections/bcir_cc.sh", "harnesses": ["bcir-cc"]},
    "emitlink": {"script": "tools/c/sections/emitlink.sh", "harnesses": ["bcir-cc"]},
    "recover": {"script": "tools/c/sections/recover.sh", "harnesses": ["bcir-cc"]},
    "writeguard": {"script": "tools/c/sections/writeguard.sh", "harnesses": ["bcir-cc"]},
    "diag": {"script": "tools/c/sections/diag.sh", "harnesses": ["test_diag"]},
    "fallback": {"script": "tools/c/sections/fallback.sh", "harnesses": ["bcir-cc"]},
    "r21policy": {"script": "tools/c/sections/r21policy.sh", "harnesses": ["bcir-cc"]},
    "project": {"script": "tools/c/sections/project.sh", "harnesses": ["bcir-cc"]},
    "link": {"script": "tools/c/sections/link.sh", "harnesses": ["bcir-cc"]},
    "effects": {"script": "tools/c/sections/effects.sh", "harnesses": ["bcir-cc"]},
    "linkflags": {"script": "tools/c/sections/linkflags.sh", "harnesses": ["bcir-cc"]}
  },
  "freestanding_checks": [
    "bcir_runtime.c", "bcir_sha256.c", "bcir_plan.c", "bcir_hydrate.c", "bcir_exec.c", "bcir_encode.c",
    "bcir_decode.c", "bcir_binrec.c", "bcir_train.c", "bcir_telemetry_frame.c", "bcir_provenance.c",
    "bcir_control_plane.c", "bcir_ring.c", "bcir_telemetry_envelope.c", "bcir_handoff.c",
    "bcir_shard_manifest.c", "bcir_kplan.c", "bcir_artifact_bundle.c", "bcir_asn1.c",
    "bcir_asn1_streampack.c", "bcir_per.c", "bcir_per_plan.c", "bcir_oer.c", "bcir_xer.c", "bcir_jer.c",
    "bcir_emit.c"
  ]
}
