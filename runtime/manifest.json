    "test_ring": {"sources": ["test_ring.c"], "libraries": ["bcir_plane", "bcir_base"], "link": ["pthread"]},
    "test_handoff": {"sources": ["test_handoff.c"], "libraries": ["bcir_plane", "bcir_streampack", "bcir_base"]},
    "test_kplan": {"sources": ["test_kplan.c"], "libraries": ["bcir_plane", "bcir_base"]},
    "test_asn1": {"sources": ["test_asn1.c"], "libraries": ["bcir_asn1"]},
    "test_asn1_streampack": {"sources": ["test_asn1_streampack.c"], "libraries": ["bcir_asn1", "bcir_base"]},
    "test_per": {"sources": ["test_per.c"], "libraries": ["bcir_asn1"]},
    "test_per_plan": {"sources": ["test_per_plan.c"], "libraries": ["bcir_asn1"]},
    "test_oer": {"sources": ["test_oer.c"], "libraries": ["bcir_asn1"]},
    "test_xer": {"sources": ["test_xer.c"], "libraries": ["bcir_asn1"]},
    "test_jer": {"sources": ["test_jer.c"], "libraries": ["bcir_asn1", "bcir_base"]},
    "test_emit": {"sources": ["test_emit.c"], "libraries": ["bcir_asn1"]},
    "test_cfront": {"sources": ["test_cfront.c"], "libraries": ["bcir_cfront", "bcir_base"]},
    "test_cfront_loop": {"sources": ["test_cfront_loop.c"], "libraries": ["bcir_cfront", "bcir_streampack", "bcir_base"], "options": ["-Wno-misleading-indentation"]},
    "test_diag": {"sources": ["test_diag.c"], "libraries": ["bcir_cfront"]},
    "test_streampack_semantic": {"sources": ["test_streampack_semantic.c"], "libraries": ["bcir_streampack", "bcir_cfront", "bcir_base"]},
    "test_channel": {"sources": ["test_channel.c"], "libraries": ["bcir_channel"]},
    "test_memory_discipline": {
      "sources": ["test_memory_discipline.c"],
      "libraries": ["bcir_driver", "bcir_cfront", "bcir_models", "bcir_streampack", "bcir_base"],
      "link": ["m"]
    },
    "test_ai_kernels": {"sources": ["test_ai_kernels.c"], "libraries": ["bcir_models"], "link": ["m"], "options": ["-ffp-contract=off"]},
    "test_q8_tables": {"sources": ["test_q8_tables.c"]},
    "test_x86_interrupt": {"sources": ["test_x86_interrupt.c"], "options": ["-ffreestanding"]}
  },
  "fuzzers": {
    "fuzz_q8_model": {"sources": ["fuzz_q8_model.c"], "libraries": ["bcir_models"], "max_len": "16384"},
    "fuzz_telemetry_frame": {"sources": ["fuzz_telemetry_frame.c"], "libraries": ["bcir_streampack", "bcir_base"]},
    "fuzz_asn1": {"sources": ["fuzz_asn1.c"], "libraries": ["bcir_asn1"], "max_len": "8192"},
    "fuzz_per": {"sources": ["fuzz_per.c"], "libraries": ["bcir_asn1"], "max_len": "4096"},
    "fuzz_xer": {"sources": ["fuzz_xer.c"], "libraries": ["bcir_asn1"], "max_len": "4096"},
    "fuzz_jer": {"sources": ["fuzz_jer.c"], "libraries": ["bcir_asn1", "bcir_base"], "max_len": "4096"},
    "fuzz_oer": {"sources": ["fuzz_oer.c"], "libraries": ["bcir_asn1"], "max_len": "4096"},
    "fuzz_per_plan": {"sources": ["fuzz_per_plan.c"], "libraries": ["bcir_asn1"], "max_len": "4096"},
    "fuzz_emit": {"sources": ["fuzz_emit.c"], "libraries": ["bcir_asn1"], "max_len": "4096"},
    "fuzz_control_plane": {"sources": ["fuzz_control_plane.c"], "libraries": ["bcir_plane", "bcir_base"], "max_len": "4096"},
    "fuzz_ring": {"sources": ["fuzz_ring.c"], "libraries": ["bcir_plane", "bcir_base"], "max_len": "4096"},
