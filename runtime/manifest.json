    "test_q8_tables_c11": {"of": "test_q8_tables", "standard": 11},
    "test_ring_tsan": {"of": "test_ring", "standard": 11, "sanitizer": "thread", "options": ["-O1", "-g"]},
    "test_ring_plain": {
      "of": "test_ring",
      "standard": 11,
      "sanitizer": "thread",
      "options": ["-O1", "-g"],
      "mutation": {"file": "bcir_ring.c", "find": "  atomic_store_explicit(word_at(r, off), (unsigned long long)v, memory_order_relaxed);", "replace": "  *(unsigned long long *)(void *)(r + off) = (unsigned long long)v;"}
    }
