# RUN: rm -rf %t && mkdir -p %t/001 && : > %t/001/answer.ll
# RUN: ! python3 %training_root/tools/grade-exercises.py --attempts %t --exercise 001 --format json --output %t/report.json
# RUN: python3 -c 'import json; r=json.load(open("%t/report.json")); x=r["results"][0]; assert x["score_percent"] == 5.0; assert any(c["outcome"] == "invalid_answer" for c in x["checks"]); assert not any(c["outcome"] == "grader_failure" for c in x["checks"])'
