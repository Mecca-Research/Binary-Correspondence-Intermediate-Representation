{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcir.dev/schemas/llvm-training/dataset-v1.json",
  "title": "LLVM training curated evaluation record v1",
  "description": "One normalized, reproducibly exported exercise from the small curated LLVM/MLIR evaluation set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "prompt", "answer_kind",
    "reference_solution", "source_files", "verification", "rubric",
    "topic_tags", "difficulty", "version_assumptions", "expected_artifacts",
    "split", "leakage_group", "concept_family", "checksums", "license",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^llvm-training-exercise-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "answer_kind": {
      "enum": ["llvm_ir", "markdown_review", "mlir_review", "optimizer_prediction", "diagnostic", "adversarial_analysis"]
    },
    "reference_solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "kind", "path", "content"],
      "properties": {
        "included": {"type": "boolean"},
        "kind": {"enum": ["file", "prompt_expected_observation"]},
        "path": {"type": ["string", "null"]},
        "content": {"type": ["string", "null"]}
      }
    },
    "source_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^llvm-training/"}
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "required_tools", "minimum_tool_versions", "tool_absence_policy", "determinism", "timeout_seconds"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimum_tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "tool_absence_policy": {"enum": ["hard_failure", "unscored_skip", "reduced_confidence_score"]},
        "determinism": {"enum": ["deterministic", "toolchain_dependent", "review_rubric"]},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "rubric": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_score", "checks"],
      "properties": {
        "maximum_score": {"type": "number", "exclusiveMinimum": 0},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "topic_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "version_assumptions": {
      "type": "object", "additionalProperties": false,
      "required": ["llvm", "mlir", "tools"],
      "properties": {
        "llvm": {"type": ["string", "null"]},
        "mlir": {"type": ["string", "null"]},
        "tools": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "expected_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "required"],
        "properties": {
          "path": {"type": "string", "pattern": "^llvm-training/"},
          "role": {"enum": ["prompt", "reference_solution", "input", "candidate", "broken_input", "grading_reference"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "split": {"enum": ["train", "validation", "test"]},
    "leakage_group": {"type": "string", "minLength": 1},
    "concept_family": {"type": "string", "minLength": 1},
    "checksums": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "prompt", "solution", "split_manifest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "prompt": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "solution": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split_manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "file"],
      "properties": {
        "spdx": {"const": "Apache-2.0"},
        "file": {"const": "LICENSE"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "exercise_manifest", "source_lineage", "exporter"],
      "properties": {
        "repository": {"const": "Binary-Correspondence-Intermediate-Representation"},
        "exercise_manifest": {"type": "string", "pattern": "^llvm-training/autograder/manifests/"},
        "source_lineage": {"type": "string", "minLength": 1},
        "exporter": {"const": "llvm-training/tools/export-exercise-dataset.py"}
      }
    }
  }
}
