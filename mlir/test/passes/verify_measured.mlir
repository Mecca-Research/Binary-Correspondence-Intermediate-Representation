    %sel_6002 = bcir.kbcir.select @c6002 from [@path_6002_scalar, @path_6002_vec8, @path_6002_vec16, @"path_6002_scalar@t2", @"path_6002_vec8@t2", @"path_6002_vec16@t2"] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @"path_6002_vec16@t2", score = 2944 : i64 } : !bcir.path
