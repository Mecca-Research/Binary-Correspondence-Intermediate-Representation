// RUN: bcir-opt -bcir-verify -verify-diagnostics -split-input-file %s
//
// PX-3b-2: the verifier over measured plans. fused_chain on x86_avx512 under a table
// pricing vector.add at t2 (q8 128): the plan -bcir-plan writes is accepted, and each
// forgery is refused with the numbers the oracle computes. GENERATED by the oracle;
// regenerate with `python -m bcir.kbcir.differential --emit-measured`.
// The oracle's plan under the table, annotated as -bcir-plan writes it, with its own
// manifest: R9 re-derives each measured realization, R13 the table's m_target.
bcir.module @fused_chain_ok attributes { kbcir.plan_score = 6848 : i64 } {
  bcir.target.capability @cpu { target_name = "x86-64-avx512", triple = "x86_64-avx512", isa_features = ["avx2", "avx512f", "fma"], lane_widths = array<i64: 1, 8, 16>, warp = 0 : i32, scalable = false, cacheline = 64 : i32, gather_penalty = 32 : i32, affinity_domains = 8 : i32, mem_channels = 4 : i32, thermal_density = 64 : i32, power_density = 64 : i32, mem_unit = 1 : i32, base_overhead = 4 : i32, per_op_heat = 1 : i32, elem_bytes = 4 : i32, cal_gen = 0 : i64, mem_tier_names = ["L1", "L2", "L3", "DRAM", "HBM", "CXL", "SSD"], mem_tier_values = array<i64: 4, 16, 16, 0, 12, 32, 48, 0, 40, 96, 96, 0, 200, 256, 256, 0, 160, 64, 192, 0, 350, 384, 512, 0, 5000, 1024, 4096, 0>, measured_gen = 1 : i64, measured_ops = ["vector.add"], measured_alternatives = ["t2"], measured_values = array<i64: 1024, 128> }
  bcir.registry @RES {
    bcir.resource @r60 { rid = 60 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r61 { rid = 61 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r62 { rid = 62 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r63 { rid = 63 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r64 { rid = 64 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
  }
  bcir.kbcir.theta @theta { thermal = 0 : i32, power = 0 : i32, mem_pressure = 0 : i32, contention = 0 : i32, noise = 0 : i32, wear = 0 : i32, utilization = 0 : i32, voltage = 0 : i32 }
  bcir.kbcir.policy @perf { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1>, base_weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c6001 attributes { claim_id = 6001 : i32, phase = @p0, op = "vector.add", reads = [@r60, @r61], writes = [@r62], count = 1024 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 3 : i32, kbcir.plan_width = 16 : i64, kbcir.plan_cost = 3904 : i64, kbcir.plan_alternative = "t2" } { %i = bcir.index_range 0 to 1024 step 1 }
