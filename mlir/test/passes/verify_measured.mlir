  bcir.gem.lane_segment @seg_6001 { claim = @c6001, phase = @p0, lane = #bcir.lane<u>, stride_k = 1 : i32, width = 16 : i32, opcode = "vector.add", reads = [@r60, @r61], writes = [@r62], fence_before = [], fence_after = [] }
