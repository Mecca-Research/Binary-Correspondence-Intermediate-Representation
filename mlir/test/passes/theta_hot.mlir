// RUN: bcir-opt -bcir-plan %s | FileCheck %s
//
// Hot-Theta plan parity -- the bcir.kbcir.theta context op lifts the cool-regime
// restriction. matmul_tiled emitted under Theta.hot(): the width-16 tiles pay the
// AVX-512 thermal coupling (x1.25) the policy weights cannot encode, so -bcir-plan
// reproduces the oracle's hot optimize() score (the cool plan was 1015808).
// Regenerate: python -m bcir.kbcir.differential --emit-theta.
bcir.module @matmul_tiled_hot {
  bcir.target.capability @cpu { target_name = "x86-64-avx512", triple = "x86_64-avx512", isa_features = ["avx2", "avx512f", "fma"], lane_widths = array<i64: 1, 8, 16>, warp = 0 : i32, scalable = false, cacheline = 64 : i32, gather_penalty = 32 : i32, affinity_domains = 8 : i32, mem_channels = 4 : i32, thermal_density = 64 : i32, power_density = 64 : i32, mem_unit = 1 : i32, base_overhead = 4 : i32, per_op_heat = 1 : i32, elem_bytes = 4 : i32, cal_gen = 0 : i64, mem_tier_names = ["L1", "L2", "L3", "DRAM", "HBM", "CXL", "SSD"], mem_tier_values = array<i64: 4, 16, 16, 0, 12, 32, 48, 0, 40, 96, 96, 0, 200, 256, 256, 0, 160, 64, 192, 0, 350, 384, 512, 0, 5000, 1024, 4096, 0> }
  bcir.registry @RES {
    bcir.resource @r1000000 { rid = 1000000 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r1000001 { rid = 1000001 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r1000002 { rid = 1000002 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r1000003 { rid = 1000003 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r2000000 { rid = 2000000 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r2000001 { rid = 2000001 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r2000002 { rid = 2000002 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r2000003 { rid = 2000003 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r3000000 { rid = 3000000 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r3000001 { rid = 3000001 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r3000002 { rid = 3000002 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r3000003 { rid = 3000003 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 128, 128>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
  }
  bcir.kbcir.theta @theta { thermal = 80 : i32, power = 60 : i32, mem_pressure = 0 : i32, contention = 0 : i32, noise = 0 : i32, wear = 0 : i32, utilization = 0 : i32, voltage = 0 : i32 }
  bcir.kbcir.policy @perf { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 4, 3, 2, 0, 0, 1, 1>, base_weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c4000 attributes { claim_id = 4000 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000000, @r2000000], writes = [@r3000000], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4001 attributes { claim_id = 4001 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000001, @r2000002, @r3000000], writes = [@r3000000], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4002 attributes { claim_id = 4002 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000000, @r2000001], writes = [@r3000001], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4003 attributes { claim_id = 4003 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000001, @r2000003, @r3000001], writes = [@r3000001], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4004 attributes { claim_id = 4004 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000002, @r2000000], writes = [@r3000002], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4005 attributes { claim_id = 4005 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000003, @r2000002, @r3000002], writes = [@r3000002], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4006 attributes { claim_id = 4006 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000002, @r2000001], writes = [@r3000003], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.claim @c4007 attributes { claim_id = 4007 : i32, phase = @p0, op = "linalg.matmul", reads = [@r1000003, @r2000003, @r3000003], writes = [@r3000003], count = 16384 : i64, lane = #bcir.lane<t>, stride_class = #bcir.stride_class<tile>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 15 : i32 } { %i = bcir.index_range 0 to 16384 step 1 }
  bcir.kbcir.plan @plan0 {
    bcir.kbcir.path @path_4000_tile { claim = @c4000, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4000 = bcir.kbcir.select @c4000 from [@path_4000_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4000_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4001_tile { claim = @c4001, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4001 = bcir.kbcir.select @c4001 from [@path_4001_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4001_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4002_tile { claim = @c4002, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4002 = bcir.kbcir.select @c4002 from [@path_4002_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4002_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4003_tile { claim = @c4003, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4003 = bcir.kbcir.select @c4003 from [@path_4003_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4003_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4004_tile { claim = @c4004, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4004 = bcir.kbcir.select @c4004 from [@path_4004_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4004_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4005_tile { claim = @c4005, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4005 = bcir.kbcir.select @c4005 from [@path_4005_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4005_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4006_tile { claim = @c4006, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4006 = bcir.kbcir.select @c4006 from [@path_4006_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4006_tile, score = 144896 : i64 } : !bcir.path
    bcir.kbcir.path @path_4007_tile { claim = @c4007, realization = "t.tile", lane = #bcir.lane<t>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 2048, memory = 61440, fabric = 0, sync = 0, compile = 0, thermal = 2560, power = 2560, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_4007 = bcir.kbcir.select @c4007 from [@path_4007_tile] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @path_4007_tile, score = 144896 : i64 } : !bcir.path
  }
  bcir.gem.lane_segment @seg_4000 { claim = @c4000, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000000, @r2000000], writes = [@r3000000], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4001 { claim = @c4001, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000001, @r2000002, @r3000000], writes = [@r3000000], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4002 { claim = @c4002, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000000, @r2000001], writes = [@r3000001], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4003 { claim = @c4003, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000001, @r2000003, @r3000001], writes = [@r3000001], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4004 { claim = @c4004, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000002, @r2000000], writes = [@r3000002], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4005 { claim = @c4005, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000003, @r2000002, @r3000002], writes = [@r3000002], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4006 { claim = @c4006, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000002, @r2000001], writes = [@r3000003], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_4007 { claim = @c4007, phase = @p0, lane = #bcir.lane<t>, stride_k = 1 : i32, width = 16 : i32, opcode = "linalg.matmul", reads = [@r1000003, @r2000003, @r3000003], writes = [@r3000003], fence_before = [], fence_after = [] }
}

