// RUN: bcir-opt -bcir-plan -bcir-verify %s | FileCheck %s
//
// PX-3b-2: measured alternatives inside K_BCIR's candidates on the law rail. Every
// example program on two targets, each under a measured table drawn over its own claims
// (bcir.target.capability's measured_* attributes: the table's generation, each entry's
// op and alternative, and its (count, q8)), and on one under a table no claim reads.
// -bcir-plan must reproduce the oracle's plan score and name kbcir.plan_alternative on
// exactly the claims whose chosen realization is a measured one; -bcir-verify must accept
// the planned module -- R9 re-derives each realization from the same offer, R13
// recomputes the manifest's m_target with the table folded in. GENERATED by the oracle;
// regenerate with `python -m bcir.kbcir.differential --emit-measured`.
//
// Omitted: the cases whose emitted lane segments -- fence-free, one a claim -- put two
// claims of one phase on different lanes on a shared write, which R10 refuses unless a
// fence pair orders it (the PX-3b-2 laws are R9 and R13, not the emitter's fences):
//   matmul_activation_relu_x86_avx512_measured
//   matmul_activation_relu_arm64_neon_measured
//   matmul_activation_relu_x86_avx512_unread

bcir.module @fused_chain_arm64_neon_measured {
  bcir.target.capability @cpu { target_name = "aarch64-neon", triple = "aarch64-neon", isa_features = ["neon"], lane_widths = array<i64: 1, 4>, warp = 0 : i32, scalable = false, cacheline = 64 : i32, gather_penalty = 32 : i32, affinity_domains = 8 : i32, mem_channels = 4 : i32, thermal_density = 64 : i32, power_density = 64 : i32, mem_unit = 1 : i32, base_overhead = 4 : i32, per_op_heat = 1 : i32, elem_bytes = 4 : i32, cal_gen = 0 : i64, mem_tier_names = ["L1", "L2", "L3", "DRAM", "HBM", "CXL", "SSD"], mem_tier_values = array<i64: 4, 16, 16, 0, 12, 32, 48, 0, 40, 96, 96, 0, 200, 256, 256, 0, 160, 64, 192, 0, 350, 384, 512, 0, 5000, 1024, 4096, 0>, measured_gen = 1 : i64, measured_ops = ["vector.add"], measured_alternatives = ["t1"], measured_values = array<i64: 1024, 217> }
  bcir.registry @RES {
    bcir.resource @r60 { rid = 60 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r61 { rid = 61 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r62 { rid = 62 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r63 { rid = 63 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
    bcir.resource @r64 { rid = 64 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 1024>, layout = #bcir.layout<soa>, access = #bcir.access<flat> }
  }
  bcir.kbcir.theta @theta { thermal = 0 : i32, power = 0 : i32, mem_pressure = 0 : i32, contention = 0 : i32, noise = 0 : i32, wear = 0 : i32, utilization = 0 : i32, voltage = 0 : i32 }
  bcir.kbcir.policy @perf { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1>, base_weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c6001 attributes { claim_id = 6001 : i32, phase = @p0, op = "vector.add", reads = [@r60, @r61], writes = [@r62], count = 1024 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 3 : i32 } { %i = bcir.index_range 0 to 1024 step 1 }
  bcir.claim @c6002 attributes { claim_id = 6002 : i32, phase = @p0, op = "vector.add", reads = [@r60, @r63], writes = [@r64], count = 1024 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, opcode = 3 : i32 } { %i = bcir.index_range 0 to 1024 step 1 }
  bcir.kbcir.plan @plan0 {
    bcir.kbcir.path @path_6001_scalar { claim = @c6001, realization = "u.scalar", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 1024, memory = 15360, fabric = 0, sync = 0, compile = 0, thermal = 1088, power = 1088, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @path_6001_vec4 { claim = @c6001, realization = "u.vec4", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 256, memory = 6144, fabric = 0, sync = 0, compile = 0, thermal = 512, power = 512, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @"path_6001_scalar@t1" { claim = @c6001, realization = "u.scalar@t1", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 868, memory = 13020, fabric = 0, sync = 0, compile = 0, thermal = 1088, power = 1088, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @"path_6001_vec4@t1" { claim = @c6001, realization = "u.vec4@t1", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 217, memory = 5208, fabric = 0, sync = 0, compile = 0, thermal = 512, power = 512, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_6001 = bcir.kbcir.select @c6001 from [@path_6001_scalar, @path_6001_vec4, @"path_6001_scalar@t1", @"path_6001_vec4@t1"] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @"path_6001_vec4@t1", score = 10850 : i64 } : !bcir.path
    bcir.kbcir.path @path_6002_scalar { claim = @c6002, realization = "u.scalar", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 1024, memory = 15360, fabric = 0, sync = 0, compile = 0, thermal = 1088, power = 1088, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @path_6002_vec4 { claim = @c6002, realization = "u.vec4", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 256, memory = 4608, fabric = 0, sync = 0, compile = 0, thermal = 512, power = 512, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @"path_6002_scalar@t1" { claim = @c6002, realization = "u.scalar@t1", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 868, memory = 13020, fabric = 0, sync = 0, compile = 0, thermal = 1088, power = 1088, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    bcir.kbcir.path @"path_6002_vec4@t1" { claim = @c6002, realization = "u.vec4@t1", lane = #bcir.lane<u>, layout = #bcir.layout<soa>, cost = #bcir.costvec<compute = 217, memory = 3906, fabric = 0, sync = 0, compile = 0, thermal = 512, power = 512, reliability = 0, security = 0, accuracy = 0, contention = 0, verification = 0> }
    %sel_6002 = bcir.kbcir.select @c6002 from [@path_6002_scalar, @path_6002_vec4, @"path_6002_scalar@t1", @"path_6002_vec4@t1"] { policy = #bcir.policy_mode<latency>, semiring = #bcir.semiring<min_plus>, selected = @"path_6002_vec4@t1", score = 8246 : i64 } : !bcir.path
  }
  bcir.gem.lane_segment @seg_6001 { claim = @c6001, phase = @p0, lane = #bcir.lane<u>, stride_k = 1 : i32, width = 4 : i32, opcode = "vector.add", reads = [@r60, @r61], writes = [@r62], fence_before = [], fence_after = [] }
  bcir.gem.lane_segment @seg_6002 { claim = @c6002, phase = @p0, lane = #bcir.lane<u>, stride_k = 1 : i32, width = 4 : i32, opcode = "vector.add", reads = [@r60, @r63], writes = [@r64], fence_before = [], fence_after = [] }
  bcir.kbcir.provenance_manifest @man { digest = 8796612873554011407 : i64, score = 19096 : i64, n_artifacts = 0 : i64, reproduced = true, m_module = 5428693435295038652 : i64, m_target = 1505894712521874030 : i64, m_theta = 1870846051561339781 : i64, m_policy = 4048695575545564183 : i64 }
}

