bcir.module @m {
  bcir.registry @RES {
    bcir.resource @r1 { rid = 1 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  // expected-error @+1 {{R3: claim c1 reads @r2 (domain mmio) does not match the claim domain ram -- the resource is in a device-isolated domain}}
  bcir.claim @c1 attributes { claim_id = 1 : i32, phase = @p0, op = "vector.add", reads = [@r1, @r2], writes = [@r1], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict> } { %i = bcir.index_range 0 to 1 step 1 }
}

// -----

// domain.mmio_claim_with_ram_operand [legal] -- the shape of every cfront MMIO write: the RAM value stored into the register
bcir.module @m {
  bcir.registry @RES {
    bcir.resource @r1 { rid = 1 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c1 attributes { claim_id = 1 : i32, phase = @p0, op = "vector.add", reads = [@r1], writes = [@r2], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<mmio>, hazard = #bcir.hazard<barriered>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, is_volatile = true } { %i = bcir.index_range 0 to 1 step 1 }
}

// -----

// domain.mmio_write_unique_hazard [R3]
bcir.module @m {
  bcir.registry @RES {
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  // expected-error @+1 {{R3: claim c1 MMIO write to @r2 requires an atomic/barriered hazard}}
  bcir.claim @c1 attributes { claim_id = 1 : i32, phase = @p0, op = "vector.add", reads = [@r2], writes = [@r2], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<mmio>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict> } { %i = bcir.index_range 0 to 1 step 1 }
}

// -----

// domain.nvm_stage_to_vram [legal] -- NVM is a memory TIER the HAM fabric stages across, not a device-isolated domain: the law rail's former 'NVM cell' isolation had no fixture, and the oracle's tier model won
bcir.module @m {
  bcir.registry @RES {
    bcir.resource @r1 { rid = 1 : i32, domain_kind = #bcir.domain<nvm>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<vram>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c1 attributes { claim_id = 1 : i32, phase = @p0, op = "vector.add", reads = [@r1], writes = [@r2], count = 8 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<vram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict> } { %i = bcir.index_range 0 to 8 step 1 }
}

// -----

// domain.mmio_claim_nvm_operand [legal] -- a device register written from a tier operand: only the resource side is isolated
bcir.module @m {
  bcir.registry @RES {
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r3 { rid = 3 : i32, domain_kind = #bcir.domain<nvm>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c1 attributes { claim_id = 1 : i32, phase = @p0, op = "vector.add", reads = [@r3], writes = [@r2], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<mmio>, hazard = #bcir.hazard<barriered>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, is_volatile = true } { %i = bcir.index_range 0 to 1 step 1 }
}

// -----

// domain.ham_on_mmio [R3]
bcir.module @m {
  bcir.registry @RES {
    // expected-error @+1 {{R3: resource r2 HAM access is illegal in the MMIO domain}}
    bcir.resource @r2 { rid = 2 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32, access = #bcir.access<ham> }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
}

