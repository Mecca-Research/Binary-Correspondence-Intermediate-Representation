// conv.legal [legal]
bcir.module @m {
  bcir.gem.conv @cv { in_c = 2 : i64, in_h = 5 : i64, in_w = 5 : i64, out_c = 3 : i64, kh = 3 : i64, kw = 3 : i64, stride = 1 : i64, pad = 0 : i64, dtype = "f32", out_h = 3 : i64, out_w = 3 : i64, gemm_m = 9 : i64, gemm_n = 3 : i64, gemm_k = 18 : i64, strategy = "direct", tile_m = 9 : i64, tile_n = 3 : i64, tile_k = 18 : i64, loop_order = "ijk", compute_cost = 0 : i64, mem_cost = 0 : i64, bottleneck = 0 : i64, quant_bits = 0 : i32, acc_bound = 0 : i64 }
}

