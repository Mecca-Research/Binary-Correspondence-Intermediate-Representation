// calibration.constants_match [legal]
bcir.module @m {
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32, gather_penalty = 32 : i32, base_overhead = 4 : i32, mem_unit = 1 : i32, cal_gen = 1 : i64 }
  bcir.kbcir.calibration @cal { target = @cpu, cal_gen = 1 : i64, samples = 5 : i64, provenance = "host", stream_q8 = 256 : i64, strided_q8 = 256 : i64, random_q8 = 8192 : i64, compute_q8 = 256 : i64 }
}

// -----

// calibration.constants_drift [R13]
bcir.module @m {
  // expected-error @+1 {{R13: capability @cpu constants drifted from calibration certificate @cal (gather_penalty 32 vs certified 64, base_overhead 4 vs certified 4, mem_unit 1 vs 1)}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32, gather_penalty = 32 : i32, base_overhead = 4 : i32, mem_unit = 1 : i32, cal_gen = 1 : i64 }
  bcir.kbcir.calibration @cal { target = @cpu, cal_gen = 1 : i64, samples = 5 : i64, provenance = "host", stream_q8 = 256 : i64, strided_q8 = 256 : i64, random_q8 = 16384 : i64, compute_q8 = 256 : i64 }
}

// -----

// calibration.strided_q8_overflow [R13] -- a ratio above INT64_MAX/4 passes R8's floor; the oracle prices in unbounded integers and sees the drift, the law rail refuses the derivation it cannot represent instead of overflowing (#762 review)
bcir.module @m {
  // expected-error @+1 {{R13: capability @cpu certificate @cal strided_q8 4611686018427387904 overflows the base_overhead derivation (4*strided_q8 exceeds signed 64-bit range)}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32, gather_penalty = 32 : i32, base_overhead = 4 : i32, mem_unit = 1 : i32, cal_gen = 1 : i64 }
  bcir.kbcir.calibration @cal { target = @cpu, cal_gen = 1 : i64, samples = 5 : i64, provenance = "host", stream_q8 = 256 : i64, strided_q8 = 4611686018427387904 : i64, random_q8 = 8192 : i64, compute_q8 = 256 : i64 }
}

// -----

// m5.binary.legal [legal] -- the NVMe SQE header
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    bcir.binary.field @opcode { name = "opcode", offset_bits = 0 : i64, width_bits = 8 : i64, kind = "u", semantic = "" }
    bcir.binary.field @command_id { name = "command_id", offset_bits = 16 : i64, width_bits = 16 : i64, kind = "u", semantic = "" }
    bcir.binary.field @namespace_id { name = "namespace_id", offset_bits = 32 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@opcode, @command_id, @namespace_id], size_bits = 64 : i64 }
  }
}

// -----

// m5.field.width_zero [R21]
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    // expected-error @+1 {{field 'a': width_bits must be positive (got 0)}}
    bcir.binary.field @a { name = "a", offset_bits = 0 : i64, width_bits = 0 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@a], size_bits = 0 : i64 }
  }
}

// -----

// m5.field.offset_negative [R21]
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    // expected-error @+1 {{field 'a': offset_bits must be non-negative (got -8)}}
    bcir.binary.field @a { name = "a", offset_bits = -8 : i64, width_bits = 8 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@a], size_bits = 0 : i64 }
  }
}

// -----

// m5.field.kind_unknown [R21]
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    // expected-error @+1 {{field 'a': kind must be one of u|s|f|bytes (got 'q')}}
    bcir.binary.field @a { name = "a", offset_bits = 0 : i64, width_bits = 8 : i64, kind = "q", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@a], size_bits = 0 : i64 }
  }
}

// -----

// m5.field.end_overflow [R21] -- the end offset is signed 64-bit on the wire; the oracle admitted an end it could not hand the law rail (#762 review)
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    // expected-error @+1 {{field 'a': offset_bits + width_bits exceeds signed 64-bit range}}
    bcir.binary.field @a { name = "a", offset_bits = 9223372036854775807 : i64, width_bits = 1 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@a], size_bits = 0 : i64 }
  }
}

// -----

// m5.record.overlap [R21]
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    bcir.binary.field @b { name = "b", offset_bits = 0 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    bcir.binary.field @c { name = "c", offset_bits = 16 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    // expected-error @+1 {{record 'r': fields 'b' and 'c' overlap (bits [0, 32) and [16, 48))}}
    bcir.binary.record @r { name = "r", fields = [@b, @c], size_bits = 0 : i64 }
  }
}

// -----

// m5.record.exceeds_size [R21]
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    bcir.binary.field @b { name = "b", offset_bits = 0 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    // expected-error @+1 {{record 'r': field 'b' ends at bit 32, beyond the record's 16 bits}}
    bcir.binary.record @r { name = "r", fields = [@b], size_bits = 16 : i64 }
  }
}

// -----

// m5.record.dangling_field [R21] -- a record's fields are objects on the oracle; only a symbol reference can dangle
bcir.module @m {
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    bcir.binary.field @b { name = "b", offset_bits = 0 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    // expected-error @+1 {{record 'r': field @ghost does not resolve to a bcir.binary.field}}
    bcir.binary.record @r { name = "r", fields = [@b, @ghost], size_bits = 0 : i64 }
  }
}

// -----

// m5.format.endianness_unknown [R21]
bcir.module @m {
  // expected-error @+1 {{format 'f': endianness must be one of little|big|le|be (got 'middle')}}
  bcir.binary.format @f attributes { endianness = "middle", alignment_bits = 8 : i64 } {
    bcir.binary.field @b { name = "b", offset_bits = 0 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@b], size_bits = 0 : i64 }
  }
}

// -----

// m5.format.alignment_zero [R21]
bcir.module @m {
  // expected-error @+1 {{format 'f': alignment_bits must be positive (got 0)}}
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 0 : i64 } {
    bcir.binary.field @b { name = "b", offset_bits = 0 : i64, width_bits = 32 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@b], size_bits = 0 : i64 }
  }
}

// -----

// m5.format.duplicate_record_name [R21] -- two records with distinct symbols and one name: the symbol table cannot see it (#762 review)
bcir.module @m {
  // expected-error @+1 {{format 'f': duplicate record name 'r'}}
  bcir.binary.format @f attributes { endianness = "little", alignment_bits = 8 : i64 } {
    bcir.binary.field @a { name = "a", offset_bits = 0 : i64, width_bits = 8 : i64, kind = "u", semantic = "" }
    bcir.binary.record @r { name = "r", fields = [@a], size_bits = 0 : i64 }
    bcir.binary.record @r2 { name = "r", fields = [@a], size_bits = 0 : i64 }
  }
}

