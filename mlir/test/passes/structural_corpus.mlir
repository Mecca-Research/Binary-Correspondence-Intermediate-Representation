// portfolio.promoted_without_certificate [R13]
bcir.module @m {
  bcir.kbcir.policy @latency { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  // expected-error @+1 {{R13: promoted policy @latency (gen 2) has no admitting replay certificate}}
  bcir.kbcir.portfolio @pf { policies = [@latency], gens = array<i64: 2>, certified = array<i64: 1> }
}

// -----

// portfolio.promoted_uncertified_without_certificate [R13] -- the oracle used to skip uncertified entries; a promotion is witnessed or it did not happen
bcir.module @m {
  bcir.kbcir.policy @latency { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  // expected-error @+1 {{R13: promoted policy @latency (gen 2) has no admitting replay certificate}}
  bcir.kbcir.portfolio @pf { policies = [@latency], gens = array<i64: 2>, certified = array<i64: 0> }
}

// -----

// portfolio.promoted_with_certificate [legal]
bcir.module @m {
  bcir.kbcir.policy @latency { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  bcir.kbcir.replay_certificate @rc0 { candidate = @latency, incumbent = @latency, episodes = 4 : i64, regressions = 0 : i64, admitted = true }
  bcir.kbcir.portfolio @pf { policies = [@latency], gens = array<i64: 2>, certified = array<i64: 1> }
}

