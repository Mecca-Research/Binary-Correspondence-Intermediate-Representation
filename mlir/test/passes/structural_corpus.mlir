  bcir.claim @c2 attributes { claim_id = 2 : i32, phase = @p1, op = "vector.add", reads = [@r1], writes = [@r1], count = 8 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<ram>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict> } { %i = bcir.index_range 0 to 8 step 1 }
}

