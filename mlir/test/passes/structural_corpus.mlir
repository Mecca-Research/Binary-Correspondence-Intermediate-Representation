// map.hbm_only [legal]
bcir.module @map {
  bcir.registry @RES {
    bcir.resource @r10 { rid = 10 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r12 { rid = 12 : i32, domain_kind = #bcir.domain<hbm>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c1000 attributes { claim_id = 1000 : i32, phase = @p0, op = "map.add", reads = [@r10, @r10], writes = [@r12], count = 8 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<hbm>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict> } { %i = bcir.index_range 0 to 8 step 1 }
}

// -----

// map.mmio_write_barriered [legal]
bcir.module @map {
  bcir.registry @RES {
    bcir.resource @r5 { rid = 5 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r10 { rid = 10 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  bcir.claim @c1000 attributes { claim_id = 1000 : i32, phase = @p0, op = "map.add", reads = [@r10], writes = [@r5], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<mmio>, hazard = #bcir.hazard<barriered>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, is_volatile = true } { %i = bcir.index_range 0 to 1 step 1 }
}

// -----

// map.mmio_write_default_hazard [R3] -- both rails also report R5 (a volatile access needs an ordered hazard)
bcir.module @map {
  bcir.registry @RES {
    bcir.resource @r5 { rid = 5 : i32, domain_kind = #bcir.domain<mmio>, shape = array<i64: 1>, layout = #bcir.layout<soa>, align = 64 : i32 }
    bcir.resource @r10 { rid = 10 : i32, domain_kind = #bcir.domain<ram>, shape = array<i64: 8>, layout = #bcir.layout<soa>, align = 64 : i32 }
  }
  bcir.phase @p0 { id = 0 : i32, deps = [] }
  // expected-error @+2 {{R3: claim c1000 MMIO write to @r5 requires an atomic/barriered hazard}}
  // expected-error @+1 {{R5: claim c1000 volatile access requires an atomic/barriered hazard}}
  bcir.claim @c1000 attributes { claim_id = 1000 : i32, phase = @p0, op = "map.add", reads = [@r10], writes = [@r5], count = 1 : i64, lane = #bcir.lane<u>, stride_class = #bcir.stride_class<unit>, stride_k = 1 : i32, offset = 0 : i64, domain = #bcir.domain<mmio>, hazard = #bcir.hazard<unique>, verify = #bcir.verify<bounds>, bounds = #bcir.bounds<strict>, is_volatile = true } { %i = bcir.index_range 0 to 1 step 1 }
}

