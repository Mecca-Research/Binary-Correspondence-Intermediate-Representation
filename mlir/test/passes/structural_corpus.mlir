  bcir.kbcir.policy @latency { mode = #bcir.policy_mode<latency>, weights = array<i64: 2, 2, 1, 1, 0, 0, 0, 1, 0, 0, 1, 1> }
  // expected-error @+1 {{R13: portfolio generation tags must be >= 1}}
  bcir.kbcir.portfolio @pf { policies = [@latency], gens = array<i64: 0>, certified = array<i64: 1> }
}

