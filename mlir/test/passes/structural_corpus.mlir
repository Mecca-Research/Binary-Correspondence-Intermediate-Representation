// target.legal [legal]
bcir.module @m {
bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
}

// -----

// target.cacheline.not_pow2 [R8] -- an op-level check on the law rail; the oracle refuses at construction -- filed under the cost law the descriptor feeds
bcir.module @m {
  // expected-error @+1 {{cacheline must be a positive power of two (got 48)}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8>, cacheline = 48 : i32, elem_bytes = 4 : i32 }
}

// -----

// target.lane_widths.empty [R8]
bcir.module @m {
  // expected-error @+1 {{lane_widths must contain at least one positive width}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
}

// -----

// target.lane_width.zero [R8]
bcir.module @m {
  // expected-error @+1 {{lane widths must be positive (got 0)}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 0>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
}

// -----

// target.elem_bytes.zero [R8]
bcir.module @m {
  // expected-error @+1 {{affinity_domains, mem_channels, mem_unit, and elem_bytes must be positive}}
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8>, cacheline = 64 : i32, elem_bytes = 0 : i32 }
}

// -----

// addr.i64_under_x86_64 [legal]
bcir.module @m {
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
  func.func @f(%addr: i64) -> i32 {
    %v = bcir.volatile_load %addr : i64 -> i32
    return %v : i32
  }
}

// -----

// addr.i32_under_x86_64 [R12]
bcir.module @m {
  bcir.target.capability @cpu { triple = "x86_64-avx512", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
  func.func @f(%addr: i32) -> i32 {
    // expected-error @+1 {{R12: the device-register address is 32 bits but the target 'x86_64-avx512' addresses 64-bit pointers; the inttoptr lowering would leave it zero-extended}}
    %v = bcir.volatile_load %addr : i32 -> i32
    return %v : i32
  }
}

// -----

// addr.i32_store_under_aarch64 [R12]
bcir.module @m {
  bcir.target.capability @cpu { triple = "aarch64-sve", isa_features = [], lane_widths = array<i64: 1, 8, 16>, cacheline = 64 : i32, elem_bytes = 4 : i32 }
  func.func @f(%v: i32, %addr: i32) {
    // expected-error @+1 {{R12: the device-register address is 32 bits but the target 'aarch64-sve' addresses 64-bit}}
    bcir.volatile_store %v, %addr : i32, i32
    return
  }
}

