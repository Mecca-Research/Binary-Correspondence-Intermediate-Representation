// m5.stream.legal [legal]
bcir.module @m {
  bcir.event.stream @s { kind = "binary", encoding = "le", element_bits = 8 : i64, max_window = 64 : i64 }
}

// -----

// m5.stream.kind_unknown [R21]
bcir.module @m {
  // expected-error @+1 {{stream 's': kind must be one of text|binary|telemetry|packet|driver|token (got 'smoke')}}
  bcir.event.stream @s { kind = "smoke", encoding = "le", element_bits = 8 : i64, max_window = 64 : i64 }
}

// -----

// m5.stream.element_bits_zero [R21]
bcir.module @m {
  // expected-error @+1 {{stream 's': element_bits must be positive (got 0)}}
  bcir.event.stream @s { kind = "binary", encoding = "le", element_bits = 0 : i64, max_window = 64 : i64 }
}

// -----

// m5.stream.max_window_zero [R21]
bcir.module @m {
  // expected-error @+1 {{stream 's': max_window must be positive (got 0)}}
  bcir.event.stream @s { kind = "binary", encoding = "le", element_bits = 8 : i64, max_window = 0 : i64 }
}

// -----

// m5.fsm.legal [legal]
bcir.module @m {
  bcir.event.stream @src { kind = "token", encoding = "utf8", element_bits = 8 : i64, max_window = 64 : i64 }
  bcir.fsm.machine @fsm attributes { kind = "transducer", input_stream = @src, start_state = @s0 } {
    bcir.fsm.state @s0 { accepting = false, error = false }
    bcir.fsm.state @s1 { accepting = true, error = false }
    bcir.fsm.transition @t0 { from = @s0, to = @s1, on = "claim", guard = "", action = "" }
  }
}

// -----

// m5.fsm.state_accepting_and_error [R21]
bcir.module @m {
  bcir.event.stream @src { kind = "token", encoding = "utf8", element_bits = 8 : i64, max_window = 64 : i64 }
  bcir.fsm.machine @fsm attributes { kind = "transducer", input_stream = @src, start_state = @s0 } {
    // expected-error @+1 {{fsm state 's0': a state is accepting or an error, not both}}
    bcir.fsm.state @s0 { accepting = true, error = true }
  }
}

// -----

// m5.fsm.transition_to_unknown_state [R21]
bcir.module @m {
  bcir.event.stream @src { kind = "token", encoding = "utf8", element_bits = 8 : i64, max_window = 64 : i64 }
  bcir.fsm.machine @fsm attributes { kind = "transducer", input_stream = @src, start_state = @s0 } {
    bcir.fsm.state @s0 { accepting = false, error = false }
    // expected-error @+1 {{fsm transition 't0': @gone does not resolve to a bcir.fsm.state}}
    bcir.fsm.transition @t0 { from = @s0, to = @gone, on = "x", guard = "", action = "" }
  }
}

// -----

// m5.fsm.duplicate_transition [R21]
bcir.module @m {
  bcir.event.stream @src { kind = "token", encoding = "utf8", element_bits = 8 : i64, max_window = 64 : i64 }
  // expected-error @+1 {{fsm machine 'fsm': transition on 'x' from @s0 is declared twice}}
  bcir.fsm.machine @fsm attributes { kind = "transducer", input_stream = @src, start_state = @s0 } {
    bcir.fsm.state @s0 { accepting = false, error = false }
    bcir.fsm.transition @t0 { from = @s0, to = @s0, on = "x", guard = "", action = "" }
    bcir.fsm.transition @t1 { from = @s0, to = @s0, on = "x", guard = "", action = "" }
  }
}

// -----

// m5.fsm.unknown_start [R21]
bcir.module @m {
  bcir.event.stream @src { kind = "token", encoding = "utf8", element_bits = 8 : i64, max_window = 64 : i64 }
  // expected-error @+1 {{fsm machine 'fsm': start_state @nowhere does not name a bcir.fsm.state of this machine}}
  bcir.fsm.machine @fsm attributes { kind = "transducer", input_stream = @src, start_state = @nowhere } {
    bcir.fsm.state @s0 { accepting = false, error = false }
  }
}

// -----

// m5.grammar.legal [legal]
bcir.module @m {
  bcir.parse.grammar @g attributes { syntax = "ebnf", start_symbol = "claim" } {
    bcir.parse.token @IDENT { pattern = "[A-Za-z_][A-Za-z0-9_]*", skip = false, precedence = 0 : i32 }
    bcir.parse.token @INT { pattern = "[0-9]+", skip = false, precedence = 0 : i32 }
  }
}

// -----

// m5.grammar.empty_start [R21]
bcir.module @m {
  // expected-error @+1 {{grammar 'g': start_symbol must be non-empty}}
  bcir.parse.grammar @g attributes { syntax = "ebnf", start_symbol = "" } {
    bcir.parse.token @IDENT { pattern = "[A-Za-z_]+", skip = false, precedence = 0 : i32 }
  }
}

// -----

// m5.grammar.no_tokens [R21] -- the tokenless body is spelled as an empty block (`^bb0:`) on the law rail (#762 review)
bcir.module @m {
  // expected-error @+1 {{grammar 'g': at least one token rule is required (tokens must be non-empty)}}
  bcir.parse.grammar @g attributes { syntax = "ebnf", start_symbol = "claim" } {
  ^bb0:
  }
}

// -----

// m5.token.empty_pattern [R21]
bcir.module @m {
  bcir.parse.grammar @g attributes { syntax = "ebnf", start_symbol = "claim" } {
    // expected-error @+1 {{token rule 'T': pattern must be non-empty}}
    bcir.parse.token @T { pattern = "", skip = false, precedence = 0 : i32 }
  }
}

// -----

// m5.grammar.duplicate_token [R21]
bcir.module @m {
  // expected-error @+1 {{grammar 'g': duplicate token rule 'T'}}
  bcir.parse.grammar @g attributes { syntax = "ebnf", start_symbol = "claim" } {
    bcir.parse.token @T { pattern = "a", skip = false, precedence = 0 : i32 }
    bcir.parse.token @T { pattern = "b", skip = false, precedence = 0 : i32 }
  }
}

