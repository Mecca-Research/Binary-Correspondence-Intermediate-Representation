{
 "_comment": "Every LLVM intrinsic the corpus does not name individually belongs to exactly one class, and every class answers for itself: taught by a chapter that names members of it in code, referenced by the quickref, or declared out of scope with a reason. The unit is the intrinsic rather than the `llvm.<family>.*` prefix, because LLVM's prefixes are not always semantic -- llvm.get.* spans the floating-point environment, the stack, and vector shape. Checked by tools/verify-langref-delta.py against reference/llvm-surface-23.json.",
 "measured_with": "LLVM (http://llvm.org/):",
 "classes": {
  "call-protocol": {
   "status": "taught",
   "where": "13-advanced-ir/04-attributes.md",
   "note": "The preallocated call protocol, taught with the ABI attributes that carry it."
  },
  "cfi-and-type-test": {
   "status": "taught",
   "where": "06-metadata/04-type-metadata-cfi.md",
   "note": "Control-flow-integrity type tests, taught with the type metadata they read."
  },
  "constrained-fp": {
   "status": "taught",
   "where": "13-advanced-ir/04-attributes.md",
   "note": "The constrained floating-point family: every arithmetic operation again, this time carrying explicit rounding and exception metadata. The corpus teaches the mechanism and names representatives; the family is one operation per libm entry by construction, so listing it would reproduce the reference manual."
  },
  "coroutine": {
   "status": "taught",
   "where": "13-advanced-ir/03-special-types-and-tokens.md",
   "note": "The coroutine lowering protocol, taught through the token types that sequence it."
  },
  "debug-annotation": {
   "status": "taught",
   "where": "06-metadata/02-debug-info.md",
   "note": "Source-annotation intrinsics, taught with the debug metadata they attach to."
  },
  "element-atomic-memop": {
   "status": "referenced",
   "where": "reference/intrinsics-quickref.md"
  },
  "experimental-staging": {
   "status": "taught",
   "where": "12-backend-jit/06-custom-bcir-intrinsics.md",
   "note": "Intrinsics staged under `llvm.experimental.` while their design settles; the corpus teaches what that prefix means for stability rather than enumerating the current set."
  },
  "fixed-point": {
   "status": "declared",
   "reason": "Embedded-C fixed-point arithmetic and the saturating shifts beside it. A complete, self-contained numeric domain with its own scale conventions; teaching it properly means teaching fixed-point, which is a subject rather than a section, and teaching it improperly is worse than the reference manual."
  },
  "fp-environment": {
   "status": "declared",
   "reason": "Dynamic floating-point environment control -- reading and setting rounding mode, exception state and denormal mode at run time. The corpus teaches floating-point under the default environment throughout; a reader who changes it at run time has left the model every other chapter assumes, and saying so is more useful than a list."
  },
  "gc-hook": {
   "status": "taught",
   "where": "13-advanced-ir/03-special-types-and-tokens.md",
   "note": "Garbage-collection read/write barriers and statepoint accessors, taught with the token types that carry the safepoint relocation."
  },
  "hardware-loop": {
   "status": "declared",
   "reason": "Backend-specific hardware loop counters, emitted by target lowering for cores with a zero-overhead loop instruction and never by a frontend. They belong to the target porting map in 12-backend-jit/, not to a chapter on reading IR."
  },
  "libm-mirror": {
   "status": "declared",
   "reason": "A libm function mirrored as an intrinsic so the optimizer can constant-fold it, vectorize it, or select a target instruction for it. The corpus teaches that mechanism once, with llvm.sqrt and llvm.fma in 13-advanced-ir/01-common-intrinsics.md, and does not enumerate libm: reading one of these teaches nothing the next repeats."
  },
  "loop-dependence": {
   "status": "declared",
   "reason": "Runtime loop-dependence masks used by the vectorizer to version a loop it could not prove independent. They are a vectorizer implementation detail that appears between passes, not in frontend output or final IR."
  },
  "objc-arc": {
   "status": "declared",
   "reason": "The Objective-C automatic reference counting runtime. Out of scope on the same boundary as every other source-language runtime: the corpus teaches the IR a frontend produces, not one language's object model."
  },
  "optimizer-barrier": {
   "status": "declared",
   "reason": "Intrinsics that exist to STOP an optimizer rather than to compute anything -- llvm.donothing, llvm.sideeffect, llvm.fake.use, llvm.ssa.copy. Each is a one-line fact whose interest is entirely in the pass that needs it, and the corpus teaches passes in 17-new-pass-manager/ rather than cataloguing their private markers."
  },
  "pointer-provenance": {
   "status": "declared",
   "reason": "Pointer provenance and object-size queries -- invariant groups, llvm.ptrmask, llvm.objectsize, and the BPF-style preserved access indices. Provenance is a deep subject the corpus touches through `noalias` and the aliasing metadata in 06-metadata/; these intrinsics are the advanced half of it and are declared rather than half-taught."
  },
  "profiling-hook": {
   "status": "declared",
   "reason": "Instrumentation hooks written by the profiling and tracing passes -- instrprof, pseudoprobe, xray, pcmarker. They are compiler-inserted bookkeeping, never written by a frontend or read by a human, and 21-performance-methodology/ teaches measurement without needing them."
  },
  "ptrauth": {
   "status": "declared",
   "reason": "ARM pointer authentication. A target-specific security feature whose intrinsics are a one-to-one spelling of that architecture's instructions -- the same boundary that puts the vendor MLIR dialects out of scope."
  },
  "sanitizer-hook": {
   "status": "declared",
   "reason": "Sanitizer instrumentation -- ASan and HWASan shadow checks, the llvm.allow.* opt-outs, and the trap intrinsics. Inserted by a pass a reader enables with a flag; the corpus teaches what sanitizers find, not the calls they leave behind."
  },
  "scalar-builtin": {
   "status": "taught",
   "where": "13-advanced-ir/01-common-intrinsics.md",
   "note": "Scalar operations LangRef exposes as intrinsics because no instruction spells them. Clang emits them from ordinary C at -O2, so a reader meets them constantly."
  },
  "setjmp-eh": {
   "status": "referenced",
   "where": "reference/intrinsics-quickref.md"
  },
  "stack-and-frame": {
   "status": "declared",
   "reason": "Stack, frame and trampoline introspection -- llvm.stacksave/restore, frame and return addresses, the stack guard slot, and the nested-function trampoline pair. Each answers a question about the target's frame layout, which 12-backend-jit/ teaches as a whole rather than one accessor at a time."
  },
  "target-register": {
   "status": "declared",
   "reason": "Direct named-register and thread-pointer access. These reach past the IR model to a specific machine register by name, and are declared out of scope for the same reason as the vendor intrinsics: the mechanism is taught in 13-advanced-ir/02-target-specific-intrinsics.md, the register lists are the target's."
  },
  "vector-predication": {
   "status": "taught",
   "where": "09-vectorization/03-vector-predication.md",
   "note": "The `llvm.vp.*` family: every arithmetic and memory operation again, this time with a mask and an explicit vector length. The chapter teaches the two-level model and names representatives; naming all of them would make the corpus a worse copy of the reference manual, which is the case that made this disposition necessary."
  },
  "vector-shape": {
   "status": "taught",
   "where": "23-version-movement/01-reading-the-delta.md",
   "note": "Vector shape manipulation -- insert, extract, reverse, splice, reduce, and the scalable-vector length queries. Heavily populated and heavily named by the corpus."
  },
  "windows-eh": {
   "status": "referenced",
   "where": "reference/intrinsics-quickref.md"
  }
 },
