      "old": "long lb=(long)(nx()>>2);",
      "path": "bcir/tests/test_c_cfront.py"
    },
    {
      "expects": "ubsan",
      "label": "UB8 the signed VLA unit sums a full-width `n`",
      "new": "int s=0;\"",
      "old": "int s=0; n%=100000;\"",
      "path": "bcir/tests/test_c_cfront.py"
    },
    {
      "expects": "ubsan",
      "label": "UB9 the signed `a--` unit multiplies a full-width `int`",
      "new": "\"int f(int a){ int x=a--; return x*100+a; }\",",
      "old": "\"int f(int a){ a %= 1000; int x=a--; return x*100+a; }\",",
      "path": "bcir/tests/test_c_cfront.py"
    },
    {
      "expects": "ubsan",
      "label": "UB10 `g` of the user-call unit multiplies a full-width `int`",
      "new": "\"int g(int x){ return x * 100000; }",
      "old": "\"int g(int x){ return (x % 20000) * 100000; }",
      "path": "bcir/tests/test_cfront.py"
    },
    {
      "expects": "ubsan",
      "label": "UB11 `l_array` shifts a negative `long` left",
      "new": "a[1] = a[0] << 1;",
      "old": "a[1] = a[0] >> 1;",
      "path": "runtime/c/cfront_compoundwide.c"
    },
    {
